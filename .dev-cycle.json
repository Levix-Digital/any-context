{
  "project_name": "any-context",
  "architecture": {
    "core_path": "crates/any-context-core-rs",
    "surfaces": [
      "cli",
      "tui"
    ],
    "canonical_datastore": "%LOCALAPPDATA%/AnyContext/config/settings.db",
    "style": "hexagonal",
    "forbidden_core_imports": [
      "actx_cli",
      "ratatui",
      "crossterm",
      "clap"
    ]
  },
  "test_commands": [
    "cargo test --workspace"
  ],
  "docs": {
    "user_doc": "README.md",
    "tec_doc": "TECDOC.md"
  },
  "tests": {
    "manual_tests": "tests/MANUAL_TESTS.md"
  },
  "devops": {
    "releases_repo": "Levix-Digital/any-context-releases",
    "integration_branch": "dev",
    "production_branch": "main",
    "release_candidates": true,
    "version_files": [
      "version.txt",
      "crates/any-context-core-rs/Cargo.toml",
      "crates/actx-cli/Cargo.toml",
      "crates/actx-agent/Cargo.toml",
      "crates/actx-lm/Cargo.toml",
      "crates/actx-onnx/Cargo.toml",
      "crates/actx-installer/Cargo.toml"
    ],
    "observability": "cli"
  },
  "drift_rules": [
    {
      "tech": "langchain",
      "conflict_msg": "Proposal suggests introducing or using 'LangChain', but baseline plan mandates its purge/removal in favor of pure Rust native architecture."
    },
    {
      "tech": "langgraph",
      "conflict_msg": "Proposal suggests using 'LangGraph', but baseline plan mandates its replacement with a native Rust FSM."
    },
    {
      "tech": "banco paralelo",
      "negative_markers": [
        "single source",
        "single database",
        "settings.db",
        "paridade"
      ],
      "proposal_allow": [],
      "conflict_msg": "Proposal hints at parallel databases ('banco paralelo'), violating Single Source of Truth (`settings.db`)."
    }
  ]
}
