# =============================================================================
# AnyContext Environment Configuration Template (.env.example)
# Copy this file to '.env' and configure your API keys and options.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI Model Provider Keys (Alternatively, manage via '/config' in chat)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
DEEPSEEK_API_KEY=...
GROQ_API_KEY=...
XAI_API_KEY=...
OPENROUTER_API_KEY=...
MISTRAL_API_KEY=...

# -----------------------------------------------------------------------------
# 2. Web Research & Search Engine (Optional)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-...

# -----------------------------------------------------------------------------
# 3. Observability & Agent Tracing (Optional - LangSmith)
# Enables real-time telemetry, tool-call tracking, token cost & latency auditing
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT="AnyContext"

# -----------------------------------------------------------------------------
# 4. Server Mode & Enterprise License Key (Optional)
# Enables REST API Server (actx --serve) and Enterprise Multi-Tenant VPC features
# -----------------------------------------------------------------------------
ANYCONTEXT_LICENSE_KEY=actx_enterprise_dev_test_signature_998877
